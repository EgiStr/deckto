{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deckto storyline.md",
  "type": "object",
  "required": ["master_title", "slides"],
  "properties": {
    "master_title": {
      "type": "string",
      "minLength": 10,
      "description": "ONE controlling statement the whole deck argues for (Minto pyramid main line)."
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide", "title", "point", "insight", "body", "visual", "visual_source", "evidence", "layout", "arc", "notes_draft"],
        "properties": {
          "slide": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 3, "description": "Assertion, not a label." },
          "point": { "type": "string", "minLength": 3 },
          "insight": { "type": "string", "minLength": 10, "description": "The so-what. Empty or trivial = slide cut." },
          "body": { "type": "string" },
          "visual": { "type": "string", "minLength": 3 },
          "visual_source": { "enum": ["existing", "generate", "research"] },
          "evidence": { "type": "string", "minLength": 1 },
          "layout": { "type": "string", "minLength": 1 },
          "arc": { "enum": ["what-is", "what-could-be", "call-to-action", "new-bliss"] },
          "notes_draft": { "type": "string", "minLength": 10 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
